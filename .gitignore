# --- Environment / secrets ---
.env
.env.*
!.env.example
!.env.local.example

# --- SSH / API keys (e.g. accidental browser downloads landing in the repo) ---
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
oci_api_key*
ssh-key-*.key*
Private & Public SSH Keys/

# --- Deploy script output (local, instance-specific, regenerated each run) ---
deploy/oracle-vm-launch-result.json
deploy/oracle-vm-retry.log

# --- Node / web app ---
node_modules/
dist/
build/
.next/
out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python / AI service ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# --- ML artifacts (large; track via releases/LFS, not git) ---
*.pt
*.pth
*.onnx
*.h5
*.ckpt
datasets/
data/raw/

# --- Media uploads (user videos, generated frames) ---
uploads/
*.mp4
*.mov
*.avi

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
._*

# --- superpowers brainstorming companion (local mockup scratch space) ---
.superpowers/

# --- Backend ---
backend/.venv/
backend/.env
backend/var/
backend/**/__pycache__/
backend/.pytest_cache/

# Test fixture video, deliberately tracked despite the blanket *.mp4 rule above.
!backend/tests/fixtures/squat.mp4
