# --- Environment / secrets ---
.env
.env.*
!.env.example
!.env.local.example

# --- Node / web app ---
node_modules/
dist/
build/
.next/
out/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python / AI service ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# --- ML artifacts (large; track via releases/LFS, not git) ---
*.pt
*.pth
*.onnx
*.h5
*.ckpt
datasets/
data/raw/

# --- Media uploads (user videos, generated frames) ---
uploads/
*.mp4
*.mov
*.avi

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
._*

# --- Backend ---
backend/.venv/
backend/.env
backend/var/
backend/**/__pycache__/
backend/.pytest_cache/

# Test fixture video, deliberately tracked despite the blanket *.mp4 rule above.
!backend/tests/fixtures/squat.mp4
